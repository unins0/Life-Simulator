// forward_fp32.comp — direct fp32 forward pass (no quantization).
//
// shader_abi: 2
//
// Bindings (std430): 0 input float[], 1 payload float[] (fp32 weights),
// 2 scale, 3 offset, 4 special (bias/threshold/dead per node), 5 output float[],
// 6 config uint[]. Same config layout and activation semantics as
// forward_packed.comp — only the weight decode differs (no decode at all).
// Config: cfg[0..7] as in forward_packed.comp (numNodes, fanIn, inputStride,
// outputStride, numCells, flags, inputBase, outputBase), then per-cell bases
// cfg[8 + cell*4 + 0..3] (payload/scale/offset/special). Input-layer
// activation (flag bit 0) applies bias/threshold/dead to the input nodes.
//
// This variant is for reference/validation. The production path is the packed
// one (forward_packed.comp): fp32 weights are 4 bytes each vs 0.25-1 byte packed.

#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Input   { float in_f[]; } input_buf;
layout(std430, binding = 1) readonly buffer Payload { float payload_f[]; } payload;
layout(std430, binding = 2) readonly buffer Scales  { float scales[]; } scale_buf;
layout(std430, binding = 3) readonly buffer Offsets { float offsets[]; } offset_buf;
layout(std430, binding = 4) readonly buffer Special { float special[]; } special_buf;
layout(std430, binding = 5) buffer Output { float out_f[]; } output_buf;
layout(std430, binding = 6) readonly buffer Config { uint cfg[]; } config_buf;

layout(constant_id = 0) const int FORMAT = 0;         // unused by fp32 path (kept for ABI)
layout(constant_id = 1) const int BLOCK_LOG2 = 3;     // unused by fp32 path (kept for ABI)
layout(constant_id = 2) const int COMPUTE_FORMAT = 0; // fp32 compute

void main() {
    uint cell = gl_GlobalInvocationID.x;
    uint numCells     = config_buf.cfg[4];
    if (cell >= numCells) {
        return; // dispatch is padded to a multiple of 64; skip overrun cells
    }
    uint numNodes     = config_buf.cfg[0];
    uint fanIn        = config_buf.cfg[1];
    uint inputStride  = config_buf.cfg[2];
    uint outputStride = config_buf.cfg[3];
    uint flags        = config_buf.cfg[5];
    uint iBase        = config_buf.cfg[6]; // input float index (cell 0)
    uint outBase      = config_buf.cfg[7]; // output float index (cell 0)
    bool activateInput = (flags & 1u) != 0u;
    uint rowBase = 8u + cell * 4u;
    uint pBase   = config_buf.cfg[rowBase + 0u]; // BYTE offset; float index = pBase >> 2
    uint spBase  = config_buf.cfg[rowBase + 3u]; // special FLOAT index
    uint outSpec = activateInput ? spBase + 3u * fanIn : spBase;

    for (uint node = 0u; node < numNodes; node++) {
        float acc = 0.0;
        for (uint k = 0u; k < fanIn; k++) {
            float x = input_buf.in_f[iBase + cell * inputStride + k];
            if (activateInput) {
                float xbias      = special_buf.special[spBase + 3u * k + 0u];
                float xthreshold = special_buf.special[spBase + 3u * k + 1u];
                float xdead      = special_buf.special[spBase + 3u * k + 2u];
                float xv = x + xbias;
                if (xv <= xthreshold) { xv = xdead; }
                x = xv;
            }
            uint logicalIndex = k * numNodes + node; // input-major (format.decompose layout)
            acc += payload.payload_f[(pBase >> 2u) + logicalIndex] * x;
        }
        float value     = acc + special_buf.special[outSpec + 3u * node + 0u];
        float threshold = special_buf.special[outSpec + 3u * node + 1u];
        float dead      = special_buf.special[outSpec + 3u * node + 2u];
        if (value <= threshold) {   // inclusive dead-zone: NOT '<'-only
            value = dead;
        }
        output_buf.out_f[outBase + cell * outputStride + node] = value;
    }
}
